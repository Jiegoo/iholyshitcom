# Safe example only: set these in your own local environment, never commit real values.
# Building and local fixture tests do not need a paid AI key. Runtime content needs your own database.

# Optional local Supabase development project; never use production credentials here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only; needed for owner-created human accounts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Local visual demo only. Fictional content, no live database or news collection.
# Never enable for a public deployment.
NEWS_DEMO=false
# Local acceptance data through a loopback Supabase stack only; forces noindex.
NEWS_LOCAL_FIXTURES=false

# Enable bilingual public reads only after your own database initialization and verification.
NEWS_BILINGUAL_PUBLIC_READ=false

# RSS requires its own explicit release, plus the existing production origin gate.
NEWS_RSS_ENABLED=false

# Public tips remain closed until abuse controls are independently verified.
# The database has a separate default-closed gate; this is not a security boundary.
NEWS_TIPS_ENABLED=false

# Optional production search indexing; leave disabled until the approved
# public domain and launch configuration are ready. Preview remains noindex.
# Use your own verified HTTPS origin; do not point a clone at the original site.
SITE_CANONICAL_ORIGIN=
SITE_INDEXING_ENABLED=false

# Enable only after recovery deployment, Supabase redirect and email delivery approval.
NEWS_AUTH_ORIGIN=

# Public manual-article reads (disable for unpublished development instances as needed).
NEWS_MANUAL_PUBLIC_READ=false
# Reader confirmation/reset email delivery: keep off until your own email service is configured.
NEWS_READER_EMAIL_ENABLED=false
